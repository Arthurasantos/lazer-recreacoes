---
import { faq, type Pergunta } from "../../data/faq";
import { linkWhatsApp } from "../../lib/whatsapp";

interface Props {
  perguntas?: Pergunta[];
}
const { perguntas = faq } = Astro.props;
---

<section id="duvidas" class="secao duvidas" aria-labelledby="duvidas-titulo">
  <div class="container duvidas__grade">
    <div>
      <p class="sobretitulo revela">Dúvidas</p>
      <h2 id="duvidas-titulo" class="display titulo-secao revela">
        Perguntas que toda família <span class="destaque">faz.</span>
      </h2>
      <p class="texto-apoio duvidas__apoio revela">
        Ficou alguma?{" "}
        <a
          href={linkWhatsApp("Olá, Paulino! Vim pelo site da Lazer e tenho uma dúvida:")}
          target="_blank"
          rel="noopener"
        >
          Pergunte no WhatsApp
        </a>
      </p>
    </div>
    <div class="duvidas__lista">
      {perguntas.map((item) => (
        <details class="duvida">
          <summary>
            <span>{item.pergunta}</span>
            <span class="duvida__icone" aria-hidden="true" />
          </summary>
          <p>{item.resposta}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .duvidas__grade {
    display: grid;
    gap: var(--space-2xl);
  }
  @media (min-width: 60rem) {
    .duvidas__grade {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }
  .duvidas__apoio {
    margin-top: var(--space-l);
  }
  .duvidas__apoio a {
    color: var(--realce);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }
  .duvidas__lista {
    display: grid;
    gap: var(--space-s);
  }
  .duvida {
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--surface-1);
    transition:
      border-color var(--dur-ui) var(--ease-out),
      background-color var(--dur-ui) var(--ease-out);
  }
  .duvida[open] {
    border-color: var(--border-strong);
    background: var(--surface-2);
  }
  .duvida summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: 3.5rem;
    padding: var(--space-m) var(--space-l);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
    border-radius: inherit;
  }
  .duvida summary::-webkit-details-marker {
    display: none;
  }
  .duvida summary:hover {
    color: var(--realce);
  }
  .duvida__icone {
    position: relative;
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    border: 2px solid var(--brand-ink);
    border-radius: 50%;
    background: var(--accent);
    box-shadow: -3px 3px 0 var(--red);
    transition: rotate 300ms var(--ease-bounce);
  }
  .duvida__icone::before,
  .duvida__icone::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0.8rem;
    height: 2.5px;
    border-radius: 2px;
    background: var(--accent-ink);
    translate: -50% -50%;
  }
  .duvida__icone::after {
    rotate: 90deg;
  }
  .duvida[open] .duvida__icone {
    rotate: 135deg;
  }
  .duvida p {
    padding: 0 var(--space-l) var(--space-l);
    color: var(--text-muted);
    max-width: 62ch;
  }
</style>

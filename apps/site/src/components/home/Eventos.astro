---
import { servicos } from "../../data/empresa";
import { linkWhatsApp, mensagemServico } from "../../lib/whatsapp";
---

<section id="eventos" class="secao secao--elevada eventos" aria-labelledby="eventos-titulo">
  <div class="container">
    <div class="eventos__topo">
      <div>
        <p class="sobretitulo revela">Eventos</p>
        <h2 id="eventos-titulo" class="display titulo-secao revela">
          Tem criança? <span class="destaque">Tem Lazer.</span>
        </h2>
      </div>
      <p class="texto-apoio revela">
        Escolha o tipo de evento e chame no WhatsApp com a mensagem pronta. O orçamento sai do jeito
        da sua festa.
      </p>
    </div>

    <ul class="eventos__grade" role="list">
      {servicos.map((s, i) => (
        <li class="revela" style={`--i: ${i % 3}`}>
          <article
            class:list={[
              "camada camada--interativa eventos__card",
              { "eventos__card--grande": i === 0 },
            ]}
          >
            <span class="eventos__numero display" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3>{s.titulo}</h3>
            <p>{s.resumo}</p>
            <a
              class="eventos__link"
              href={linkWhatsApp(mensagemServico(s.pedido))}
              target="_blank"
              rel="noopener"
              data-evento={`whatsapp_servico_${s.id}`}
            >
              Pedir orçamento<span class="sr-only"> para {s.titulo.toLowerCase()}</span>
              <span aria-hidden="true"> →</span>
            </a>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .eventos__topo {
    display: grid;
    gap: var(--space-l);
    align-items: end;
  }
  @media (min-width: 60rem) {
    .eventos__topo {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  .eventos__grade {
    display: grid;
    gap: calc(var(--space-l) + var(--layer));
    margin: var(--space-2xl) 0 0;
    padding: 0 0 0 var(--layer);
    list-style: none;
  }
  @media (min-width: 40rem) {
    .eventos__grade {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .eventos__grade {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .eventos__grade > li {
    display: grid;
  }
  .eventos__card {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-s);
    padding: var(--space-xl);
  }
  .eventos__card--grande {
    --camada-cor: var(--red);
    background: var(--surface-2);
  }
  .eventos__numero {
    font-size: var(--step-3);
    color: transparent;
    -webkit-text-stroke: 1.5px var(--accent);
  }
  .eventos__card h3 {
    font-size: var(--step-2);
  }
  .eventos__card p {
    color: var(--text-muted);
  }
  .eventos__link {
    justify-self: start;
    margin-top: var(--space-s);
    padding-block: var(--space-xs);
    font-weight: 750;
    color: var(--accent);
    text-decoration: none;
  }
  /* O card inteiro é clicável, mantendo um único link acessível */
  .eventos__link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .eventos__card:focus-within {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }
  .eventos__link:focus-visible {
    outline: none;
  }
</style>

---
import Foto from "../Foto.astro";
import { empresa } from "../../data/empresa";
import { fotos } from "../../data/fotos";

const molduras = [
  { foto: fotos.equipeCarnaval, giro: -3, camada: "vermelha" },
  { foto: fotos.senna, giro: 2 },
  { foto: fotos.harryPotter, giro: -1.5 },
  { foto: fotos.risadas, giro: 3 },
  { foto: fotos.futebolRecreadores, giro: -2, camada: "vermelha" },
  { foto: fotos.inflavelPraia, giro: 1.5 },
  { foto: fotos.futebolTurma, giro: 2.5 },
  { foto: fotos.equipeBrasil, giro: -2.5 },
  { foto: fotos.lego, giro: 1, camada: "vermelha" },
];
---

<section class="secao galeria" aria-labelledby="galeria-titulo">
  <div class="container">
    <div class="galeria__topo">
      <div>
        <p class="sobretitulo revela">Galeria</p>
        <h2 id="galeria-titulo" class="display titulo-secao revela">
          A festa de verdade está no <span class="destaque">Instagram.</span>
        </h2>
      </div>
      <a
        class="botao botao--fantasma revela"
        href={empresa.instagram.url}
        target="_blank"
        rel="noopener"
      >
        Ver @{empresa.instagram.usuario}
      </a>
    </div>
    <ul class="galeria__grade" role="list">
      {molduras.map((m, i) => (
        <li class="revela" style={`--i: ${i % 3}`}>
          <figure
            class:list={[
              "camada camada--interativa galeria__foto",
              { "camada--vermelha": m.camada === "vermelha" },
            ]}
            style={`rotate: ${m.giro}deg`}
          >
            <Foto foto={m.foto} sizes="(min-width: 60rem) 24rem, 45vw" />
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .galeria__topo {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-l);
  }
  .galeria__grade {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: calc(var(--space-l) + var(--layer));
    margin: var(--space-2xl) 0 0;
    padding: 0 0 0 var(--layer);
    list-style: none;
  }
  @media (min-width: 60rem) {
    .galeria__grade {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .galeria__foto {
    margin: 0;
    aspect-ratio: 1;
  }
  /* No celular (2 colunas), a última foto de uma lista ímpar ocupa a linha toda */
  @media (max-width: 59.99rem) {
    .galeria__grade > li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
    .galeria__grade > li:last-child:nth-child(odd) .galeria__foto {
      aspect-ratio: 2 / 1;
    }
  }
  .galeria__foto :global(.foto-quadro) {
    border-radius: calc(var(--radius-l) - var(--outline));
    overflow: hidden;
  }
</style>

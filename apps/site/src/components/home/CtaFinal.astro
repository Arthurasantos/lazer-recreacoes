---
import Bonequinho from "../Bonequinho.astro";
import IconeWhatsApp from "../IconeWhatsApp.astro";
import { empresa } from "../../data/empresa";
import { linkWhatsApp, mensagemGeral } from "../../lib/whatsapp";

interface Props {
  mensagem?: string;
}
const { mensagem = mensagemGeral() } = Astro.props;
---

<section class="secao cta-final" aria-labelledby="cta-final-titulo" data-esconde-cta-fixo>
  <div class="container">
    <div class="camada cta-final__caixa revela">
      <div class="cta-final__texto">
        <h2 id="cta-final-titulo" class="display cta-final__titulo">
          Chama a <span class="destaque">Lazer.</span>
        </h2>
        <p class="texto-apoio">
          Conte a data, o lugar e quantas crianças vão brincar. O resto é com a gente.
        </p>
        <a
          class="botao botao--grande"
          href={linkWhatsApp(mensagem)}
          target="_blank"
          rel="noopener"
          data-evento="whatsapp_cta_final"
        >
          <IconeWhatsApp />
          Quero um orçamento
        </a>
        <p class="cta-final__micro">
          WhatsApp {empresa.whatsapp.exibicao} · falar com {empresa.whatsapp.contato}
        </p>
      </div>
      <div class="cta-final__boneco" data-boneco-pula>
        <Bonequinho pose="acena" olhar />
      </div>
    </div>
  </div>
</section>

<style>
  .cta-final__caixa {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
    margin-left: var(--layer);
    padding: clamp(2rem, 1rem + 4vw, 4.5rem);
    background: var(--red);
    color: var(--on-red);
    overflow: hidden;
  }
  @media (min-width: 48rem) {
    .cta-final__caixa {
      grid-template-columns: 1fr auto;
    }
  }
  .cta-final__texto {
    display: grid;
    gap: var(--space-l);
    justify-items: start;
  }
  .cta-final__titulo {
    font-size: var(--step-5);
  }
  .cta-final__titulo .destaque {
    color: var(--brand-yellow);
    text-shadow: -0.06em 0.06em 0 var(--brand-ink);
  }
  .cta-final__caixa :global(.texto-apoio) {
    color: var(--on-red);
  }
  .cta-final__micro {
    font-size: var(--step--1);
    color: var(--on-red);
    opacity: 0.9;
  }
  .cta-final__boneco {
    width: clamp(8rem, 6rem + 8vw, 13rem);
    justify-self: center;
    cursor: pointer;
  }
</style>

---
/**
 * Marca visível de conteúdo que depende de material real (foto, número, texto a confirmar).
 * Existe para nunca inventarmos prova: tudo que aparece com este selo precisa ser substituído
 * antes da publicação oficial. Buscar por "<Pendente" para listar tudo.
 */
interface Props {
  rotulo: string;
  detalhe?: string;
  class?: string;
}
const { rotulo, detalhe, class: classe, ...resto } = Astro.props;
---

<div class:list={["pendente", classe]} data-pendente={rotulo} {...resto}>
  <slot />
  <p class="pendente__rotulo">[{rotulo}]</p>
  {detalhe && <p class="pendente__detalhe">{detalhe}</p>}
</div>

<style>
  .pendente {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-xs);
    height: 100%;
    min-height: 10rem;
    padding: var(--space-l);
    text-align: center;
    border-radius: inherit;
    background:
      repeating-linear-gradient(-45deg, oklch(100% 0 0 / 0.025) 0 12px, transparent 12px 24px),
      var(--surface-2);
  }
  .pendente__rotulo {
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pendente__detalhe {
    font-size: var(--step--1);
    color: var(--text-muted);
    max-width: 30ch;
  }
</style>

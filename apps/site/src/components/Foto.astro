---
/** Foto otimizada (AVIF/WebP em vários tamanhos) que preenche a moldura em que está. */
import { Picture } from "astro:assets";
import type { Foto } from "../data/fotos";

interface Props {
  foto: Foto;
  /** Largura exibida, para o navegador escolher o arquivo certo */
  sizes: string;
  /** true só para a imagem principal do topo da página */
  prioridade?: boolean;
  class?: string;
}
const { foto, sizes, prioridade = false, class: classe } = Astro.props;
const larguras = [320, 480, 640, 800, 960, 1200].filter((w) => w <= foto.src.width);
if (!larguras.includes(foto.src.width) && foto.src.width < 1200) larguras.push(foto.src.width);
---

<Picture
  src={foto.src}
  alt={foto.alt}
  formats={["avif", "webp"]}
  widths={larguras}
  sizes={sizes}
  loading={prioridade ? "eager" : "lazy"}
  fetchpriority={prioridade ? "high" : "auto"}
  decoding="async"
  class:list={["foto", classe]}
  pictureAttributes={{ class: "foto-quadro" }}
/>

<style>
  /* Globais: o <img> e o <picture> são renderizados pelo componente Picture do Astro */
  :global(.foto-quadro) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
  }
  :global(.foto) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }
</style>
